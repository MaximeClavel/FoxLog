{
  "manifest_version": 3,
  "name": "FoxLog - Salesforce Debug Log Viewer",
  "version": "1.9.1",
  "description": "Display Salesforce debug logs in a modern UI with flow graph, anti-pattern analysis, log diffing, and one-click debug control.",

  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    },
    "default_title": "FoxLog Settings"
  },

  "host_permissions": [
    "https://*.my.salesforce.com/*",
    "https://*.lightning.force.com/*"
  ],

  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*"
      ],
      "js": [
        "src/core/constants.js",
        "src/core/icons.js",
        "src/core/logger.js",
        "src/core/cache-manager.js",
        "src/services/session-manager.js",
        "src/services/salesforce-api.js",
        "src/services/debug-level-manager.js",
        "src/services/log-preview-service.js",
        "src/services/call-tree-builder.js",
        "src/services/anti-pattern-detector.js",
        "src/services/log-diff-engine.js",
        "src/parsers/log-parser.js",
        "src/ui/filter-manager.js",
        "src/ui/call-tree-view.js",
        "src/ui/call-graph-view.js",
        "src/ui/log-diff-view.js",
        "src/ui/modal-manager.js",
        "src/ui/panel-manager.js",
        "src/content.js"
      ],
      "css": ["src/theme.css", "src/styles.css", "src/modal-styles.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "background": {
    "scripts": ["src/background.js"]
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/*.png",
        "src/workers/call-tree-worker.js",
        "src/workers/log-diff-worker.js",
        "src/injected.js"
      ],
      "matches": [
        "https://*.lightning.force.com/*"
      ]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "foxlog@foxlog.extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
